<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
  <title>Vakinha direta</title>
  <meta name="theme-color" content="#050607" />
  <style>
    :root{
      --bg:#050607;
      --panel:#111315;
      --panel2:#15181b;
      --line:rgba(255,255,255,.09);
      --muted:#a8adb3;
      --text:#f4f6f7;
      --green:#6ee178;
      --green2:#3dbd62;
      --danger:#ff5b72;
      --shadow:0 22px 70px rgba(0,0,0,.55);
      --radius:24px;
    }
    *{box-sizing:border-box}
    html,body{margin:0;min-height:100%;background:var(--bg);color:var(--text);font-family:Inter,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Arial,sans-serif}
    body{
      background:
        radial-gradient(circle at 50% 0%,rgba(106,225,120,.16),transparent 32rem),
        radial-gradient(circle at 10% 30%,rgba(255,255,255,.06),transparent 24rem),
        linear-gradient(180deg,#060707,#090b0c 42%,#050607);
      overflow-x:hidden;
    }
    button,input,textarea{font:inherit}
    .noise{position:fixed;inset:0;pointer-events:none;opacity:.075;background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 250 250' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.82' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.65'/%3E%3C/svg%3E");mix-blend-mode:screen}
    .wrap{width:min(100%,920px);margin:auto;padding:14px 12px 28px}
    .shell{border:1px solid var(--line);border-radius:18px;background:rgba(14,16,18,.62);box-shadow:var(--shadow);backdrop-filter:blur(12px);overflow:hidden}
    .inner{padding:22px clamp(14px,3.4vw,34px)}
    .hero{text-align:center;padding:8px 0 22px}
    h1{margin:0;font-size:clamp(1.85rem,6.7vw,3.35rem);letter-spacing:-.06em;line-height:.98;font-weight:900}
    .accent{color:var(--green)}
    .lead{margin:14px auto 0;color:#d9dcde;font-size:clamp(.95rem,3.2vw,1.16rem);line-height:1.42;max-width:660px}
    .card{border:1px solid var(--line);border-radius:var(--radius);background:linear-gradient(145deg,rgba(255,255,255,.055),rgba(255,255,255,.018));box-shadow:inset 0 1px 0 rgba(255,255,255,.06);padding:clamp(16px,3.4vw,28px);margin:13px 0}
    .progressTop{display:grid;grid-template-columns:1fr auto 1fr;gap:12px;align-items:start}
    .label{color:#f0f2f3;font-size:1.02rem}
    .money{font-size:clamp(1.55rem,5.1vw,2.45rem);line-height:1.1;font-weight:850;letter-spacing:-.045em;margin-top:5px}
    .raised{color:var(--green)}
    .meta{text-align:right}
    .percent{font-size:clamp(1.15rem,4.3vw,1.65rem);font-weight:850;color:var(--green);padding-top:20px}
    .bar{height:22px;background:rgba(255,255,255,.09);border-radius:999px;margin:18px 0 12px;overflow:hidden}
    .fill{height:100%;width:0%;border-radius:inherit;background:linear-gradient(90deg,var(--green),var(--green2));box-shadow:0 0 26px rgba(110,225,120,.35);transition:width .6s ease}
    .remain{text-align:center;color:#d9dcde;font-size:1.05rem}
    .donate{text-align:center;position:relative}
    .icon{
      width:64px;height:64px;border-radius:50%;display:grid;place-items:center;margin:0 auto 14px;
      background:rgba(255,255,255,.09);border:1px solid rgba(255,255,255,.08);font-size:2rem;color:var(--green)
    }
    h2{margin:0 0 10px;font-size:clamp(1.55rem,5vw,2.2rem);letter-spacing:-.05em;line-height:1.05}
    .small{color:#d9dcde;font-size:clamp(.94rem,3.2vw,1.05rem);line-height:1.42;margin:0 auto 16px;max-width:590px}
    .qrBox{display:inline-block;background:white;border-radius:12px;padding:14px;margin:6px auto 14px;box-shadow:0 18px 50px rgba(0,0,0,.45)}
    #qrcode{width:220px;height:220px}
    #qrcode img,#qrcode canvas{width:220px!important;height:220px!important;display:block}
    .btn{
      width:min(100%,390px);border:0;border-radius:10px;padding:16px 18px;min-height:58px;
      color:white;background:linear-gradient(135deg,#65d975,#35a954);font-weight:850;font-size:1.18rem;
      display:inline-flex;align-items:center;justify-content:center;gap:10px;cursor:pointer;
      box-shadow:0 14px 34px rgba(55,185,90,.25);transition:.18s transform,.18s filter
    }
    .btn:active{transform:scale(.975)}
    .btn.secondary{background:linear-gradient(135deg,#25292d,#191c1f);box-shadow:none;border:1px solid rgba(255,255,255,.08)}
    .trust{display:flex;align-items:center;justify-content:center;gap:8px;color:#c9ced2;margin-top:15px;font-size:1rem}
    .divider{display:grid;grid-template-columns:1fr auto 1fr;align-items:center;gap:14px;color:#bfc4c8;margin:-4px auto -4px;max-width:440px}
    .divider:before,.divider:after{content:"";height:1px;background:rgba(255,255,255,.15)}
    .pixKey{width:min(100%,720px);margin:18px auto 16px;border:1px solid rgba(255,255,255,.11);border-radius:12px;background:rgba(255,255,255,.055);padding:22px 16px;color:var(--green);font-size:clamp(1.02rem,4.7vw,1.8rem);font-weight:850;letter-spacing:.01em;word-break:break-all}
    .footer{display:flex;gap:16px;align-items:center;justify-content:center;color:#d7dbde;padding:10px 0 0;line-height:1.35}
    .footer .shield{color:var(--green);font-size:2.2rem}
    .toast{position:fixed;left:50%;bottom:18px;transform:translateX(-50%) translateY(22px);opacity:0;background:#f5f7f8;color:#050607;border-radius:999px;padding:12px 18px;font-weight:800;box-shadow:0 20px 55px rgba(0,0,0,.45);z-index:50;transition:.22s}
    .toast.show{opacity:1;transform:translateX(-50%) translateY(0)}

    .topMenu{position:fixed;top:14px;right:14px;z-index:40}
    .hamb{width:46px;height:46px;border-radius:13px;border:1px solid rgba(255,255,255,.1);background:rgba(15,17,19,.76);color:white;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:4px;cursor:pointer;box-shadow:0 14px 40px rgba(0,0,0,.34);backdrop-filter:blur(10px)}
    .hamb span,.hamb:before,.hamb:after{content:"";display:block;width:18px;height:2px;background:#f5f7f8;border-radius:99px}
    .hamb span{margin:0}
    .menuDrop{position:absolute;right:0;top:54px;width:190px;padding:8px;border:1px solid rgba(255,255,255,.1);border-radius:15px;background:rgba(15,17,19,.94);box-shadow:0 18px 50px rgba(0,0,0,.45);display:none}
    .menuDrop.open{display:block}
    .menuItem{width:100%;border:0;background:transparent;color:#f5f7f8;text-align:left;padding:13px 12px;border-radius:10px;cursor:pointer;font-weight:800}
    .menuItem:active{transform:scale(.98)}
    .menuItem:hover{background:rgba(255,255,255,.06)}
    .passModal{position:fixed;inset:0;z-index:60;display:none;align-items:center;justify-content:center;background:rgba(0,0,0,.58);padding:18px}
    .passModal.open{display:flex}
    .passBox{width:min(100%,360px);border:1px solid rgba(255,255,255,.11);border-radius:18px;background:#101214;padding:18px;box-shadow:0 22px 70px rgba(0,0,0,.55)}
    .passBox h3{margin:0 0 8px;font-size:1.25rem;letter-spacing:-.03em}
    .passBox p{margin:0 0 12px;color:#aeb4b8}

    .adminGate{display:none}
    body.admin .adminGate{display:block}
    .adminPanel{margin-top:18px;border:1px solid rgba(110,225,120,.18);background:rgba(8,18,12,.72)}
    .adminGrid{display:grid;grid-template-columns:1fr 1fr;gap:12px}
    .field{display:flex;flex-direction:column;gap:7px}
    .field.full{grid-column:1/-1}
    .field span{font-size:.88rem;color:#bfc5c9;font-weight:700}
    input,textarea{
      width:100%;border:1px solid rgba(255,255,255,.11);background:rgba(255,255,255,.055);color:white;border-radius:11px;padding:13px 14px;outline:none
    }
    textarea{min-height:96px;resize:vertical}
    .adminActions{display:flex;gap:10px;flex-wrap:wrap;margin-top:14px}
    .mini{width:auto;min-height:46px;padding:12px 15px;font-size:.98rem;border-radius:10px}
    .status{color:var(--muted);font-size:.92rem;margin-top:10px}
    .hide{display:none!important}
    @media(max-width:640px){
      .wrap{padding:12px 10px 26px}
      .inner{padding:22px 14px}
      .progressTop{grid-template-columns:1fr 1fr}
      .percent{grid-column:1/-1;grid-row:2;text-align:center;padding-top:0}
      .meta{text-align:right}
      .bar{height:18px}
      #qrcode,#qrcode img,#qrcode canvas{width:min(68vw,220px)!important;height:min(68vw,220px)!important}
      .adminGrid{grid-template-columns:1fr}
      .footer{align-items:flex-start;justify-content:flex-start}
    }
  </style>
</head>
<body>
  <div class="topMenu">
    <button class="hamb" id="hambBtn" aria-label="menu"><span></span></button>
    <div class="menuDrop" id="menuDrop">
      <button class="menuItem" id="openAdminBtn">admin</button>
    </div>
  </div>

  <div class="passModal" id="passModal">
    <div class="passBox">
      <h3>admin</h3>
      <p>digita a senha pra abrir o painel.</p>
      <input id="adminCode" type="password" inputmode="numeric" placeholder="senha" />
      <div class="adminActions">
        <button class="btn mini" id="unlockAdminBtn">entrar</button>
        <button class="btn secondary mini" id="closePassBtn">fechar</button>
      </div>
    </div>
  </div>

  <div class="noise"></div>
  <main class="wrap">
    <section class="shell">
      <div class="inner">
        <header class="hero">
          <h1 id="title">me ajuda a <span class="accent">bater essa meta</span></h1>
          <p class="lead" id="subtitle">r$1 já conta. direto no pix, sem plataforma no meio.</p>
        </header>

        <section class="card">
          <div class="progressTop">
            <div>
              <div class="label">Arrecadado</div>
              <div class="money raised" id="raisedText">R$ 0,00</div>
            </div>
            <div class="percent" id="percentText">0%</div>
            <div class="meta">
              <div class="label">Meta</div>
              <div class="money" id="goalText">R$ 0,00</div>
            </div>
          </div>
          <div class="bar"><div class="fill" id="fill"></div></div>
          <div class="remain" id="remainText">Carregando...</div>
        </section>

        <section class="card donate">
          <div class="icon">♡</div>
          <h2 id="qrTitle">manda <span class="accent">R$1</span></h2>
          <p class="small" id="qrText">esse qr code é pra quem quiser doar 1 real! tem opção de copiar pix tb</p>
          <div class="qrBox"><div id="qrcode" aria-label="qr code pix"></div></div><br>
          <button class="btn" id="copyPixBtn">copiar pix de r$1</button>
          <div class="trust"></div>
        </section>

        <div class="divider">ou</div>

        <section class="card donate">
          <div class="icon">$</div>
          <h2 id="keyTitle">quer mandar <span class="accent">outro valor?</span></h2>
          <p class="small" id="keyText">aqui é caso vc queira doar QUALQUER valor, e muito obrigado!!</p>
          <div class="pixKey" id="pixKeyBox">9d95f7fb-db26-4277-b685-9f4d72800c0f</div>
          <button class="btn secondary" id="copyKeyBtn">copiar chave pix</button>
        </section>

        <footer class="footer">
          <div class="shield">♢</div>
          <div id="footerText">a barra é atualizada manualmente.</div>
        </footer>

        <section class="card adminPanel adminGate">
          <h2 style="font-size:1.6rem">admin</h2>
          <p class="small" style="margin-left:0;text-align:left">painel simples. senha no menu, edita a barra e salva.</p>

          <form id="adminForm">
            <div class="adminGrid">
              <label class="field"><span>arrecadado</span><input id="fRaised" type="number" step="0.01" min="0"></label>
              <label class="field"><span>meta</span><input id="fGoal" type="number" step="0.01" min="1"></label>
              <label class="field full"><span>título</span><input id="fTitle"></label>
              <label class="field full"><span>subtítulo</span><input id="fSubtitle"></label>
              <label class="field full"><span>texto do qr de r$1</span><textarea id="fQrText"></textarea></label>
              <label class="field full"><span>pix copia e cola de r$1</span><textarea id="fPixCode"></textarea></label>
              <label class="field full"><span>chave pix para qualquer valor</span><input id="fPixKey"></label>
              <label class="field full"><span>rodapé</span><textarea id="fFooter"></textarea></label>
            </div>
            <div class="adminActions">
              <button class="btn mini" type="submit">salvar no firebase</button>
            </div>
          </form>
          <div class="status" id="adminStatus">abre pelo menu de três barrinhas. senha: 040824.</div>
        </section>
      </div>
    </section>
  </main>

  <div class="toast" id="toast">copiado</div>

  <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
  <script type="module">
    import { initializeApp } from "https://www.gstatic.com/firebasejs/10.12.5/firebase-app.js";
    import { getDatabase, ref, onValue, set } from "https://www.gstatic.com/firebasejs/10.12.5/firebase-database.js";

    const firebaseConfig = {
      apiKey: "AIzaSyDJpqyCiPZzx-Ptoj-cYAw-FMQ-31aHtl4",
      authDomain: "edu-sem-all.firebaseapp.com",
      databaseURL: "https://edu-sem-all-default-rtdb.firebaseio.com/",
      projectId: "edu-sem-all",
      storageBucket: "edu-sem-all.firebasestorage.app",
      messagingSenderId: "643275978214",
      appId: "1:643275978214:web:e0e85e2bdad2a0d794d227"
    };

    const DEFAULT_DATA = {
      title: "me ajuda a <span class=\"accent\">bater essa meta</span>",
      subtitle: "r$1 já conta. direto no pix, sem plataforma no meio.",
      raised: 356,
      goal: 2000,
      qrTitle: "manda <span class=\"accent\">R$1</span>",
      qrText: "esse qr code é pra quem quiser doar 1 real! tem opção de copiar pix tb",
      pixCode: "00020126580014BR.GOV.BCB.PIX01369d95f7fb-db26-4277-b685-9f4d72800c0f52040000530398654041.005802BR5924Luis Eduardo Pinheiro de6009SAO PAULO62140510POp2DT0dCB6304B950",
      pixKey: "9d95f7fb-db26-4277-b685-9f4d72800c0f",
      keyTitle: "quer mandar <span class=\"accent\">outro valor?</span>",
      keyText: "aqui é caso vc queira doar QUALQUER valor, e muito obrigado!!",
      footerText: "a barra é atualizada manualmente."
    };

    const PATH = "vakinha/public";
    let app, db, currentData = {...DEFAULT_DATA}, qr;
    const $ = id => document.getElementById(id);
    const brl = n => Number(n || 0).toLocaleString("pt-BR",{style:"currency",currency:"BRL"});

    function safeHtml(s){ return String(s || "").replace(/<script/gi,"&lt;script"); }
    function toast(msg){
      $("toast").textContent = msg;
      $("toast").classList.add("show");
      setTimeout(()=>$("toast").classList.remove("show"),1500);
    }
    async function copyText(text){
      try{
        await navigator.clipboard.writeText(text);
        toast("copiado");
      }catch(e){
        const ta=document.createElement("textarea");
        ta.value=text; document.body.appendChild(ta); ta.select();
        document.execCommand("copy"); ta.remove(); toast("copiado");
      }
    }
    function render(data){
      currentData = {...DEFAULT_DATA,...(data || {})};
      $("title").innerHTML = safeHtml(currentData.title);
      $("subtitle").textContent = currentData.subtitle || "";
      $("qrTitle").innerHTML = safeHtml(currentData.qrTitle);
      $("qrText").textContent = currentData.qrText || "";
      $("keyTitle").innerHTML = safeHtml(currentData.keyTitle);
      $("keyText").textContent = currentData.keyText || "";
      $("pixKeyBox").textContent = currentData.pixKey || "";
      $("footerText").innerHTML = safeHtml(currentData.footerText).replace(/\n/g,"<br>");

      const raised = Number(currentData.raised || 0);
      const goal = Math.max(1, Number(currentData.goal || 1));
      const p = Math.max(0, Math.min(100, (raised / goal) * 100));
      $("raisedText").textContent = brl(raised);
      $("goalText").textContent = brl(goal);
      $("percentText").textContent = p.toFixed(2).replace(".",",") + "%";
      $("fill").style.width = p + "%";
      $("remainText").textContent = raised >= goal
        ? "meta batida. obrigado de verdade."
        : `faltam ${brl(goal-raised)} para atingirmos nossa meta.`;

      $("qrcode").innerHTML = "";
      qr = new QRCode($("qrcode"), {
        text: currentData.pixCode || currentData.pixKey || "",
        width: 220,
        height: 220,
        correctLevel: QRCode.CorrectLevel.M
      });
      fillAdminForm();
    }
    function fillAdminForm(){
      const d=currentData;
      $("fRaised").value=d.raised ?? 0;
      $("fGoal").value=d.goal ?? 2000;
      $("fTitle").value=d.title ?? "";
      $("fSubtitle").value=d.subtitle ?? "";
      $("fQrText").value=d.qrText ?? "";
      $("fPixCode").value=d.pixCode ?? "";
      $("fPixKey").value=d.pixKey ?? "";
      $("fFooter").value=(d.footerText ?? "").replace(/<br\s*\/?>/gi,"\n");
    }
    function readForm(){
      return {
        ...currentData,
        raised: Number($("fRaised").value || 0),
        goal: Number($("fGoal").value || 1),
        title: $("fTitle").value.trim(),
        subtitle: $("fSubtitle").value.trim(),
        qrText: $("fQrText").value.trim(),
        pixCode: $("fPixCode").value.trim(),
        pixKey: $("fPixKey").value.trim(),
        footerText: $("fFooter").value.trim().replace(/\n/g,"<br>")
      };
    }

    $("copyPixBtn").onclick = () => copyText(currentData.pixCode);
    $("copyKeyBtn").onclick = () => copyText(currentData.pixKey);

    if(location.hash.toLowerCase().includes("admin")){
      document.body.classList.add("admin");
    }


    $("hambBtn").onclick = () => $("menuDrop").classList.toggle("open");
    $("openAdminBtn").onclick = () => {
      $("menuDrop").classList.remove("open");
      $("passModal").classList.add("open");
      setTimeout(()=>$("adminCode").focus(),50);
    };
    $("closePassBtn").onclick = () => $("passModal").classList.remove("open");
    $("unlockAdminBtn").onclick = () => {
      if($("adminCode").value === "040824"){
        document.body.classList.add("admin");
        $("passModal").classList.remove("open");
        toast("admin aberto");
        $("adminStatus").textContent = "admin aberto. edita o valor e salva.";
        history.replaceState(null,"", location.pathname + location.search);
      }else{
        toast("senha errada");
      }
    };
    $("adminCode").addEventListener("keydown", e => {
      if(e.key === "Enter") $("unlockAdminBtn").click();
      if(e.key === "Escape") $("closePassBtn").click();
    });

    try{
      app = initializeApp(firebaseConfig);
      db = getDatabase(app);
      onValue(ref(db, PATH), snap => {
        const data = snap.val();
        render(data || DEFAULT_DATA);
      }, err => {
        console.warn(err);
        render(DEFAULT_DATA);
        $("adminStatus").textContent = "firebase não liberou leitura. confira as rules.";
      });

      $("adminForm").onsubmit = async e => {
        e.preventDefault();
        try{
          await set(ref(db, PATH), readForm());
          toast("salvo");
          $("adminStatus").textContent = "salvo no firebase.";
        }catch(err){
          $("adminStatus").textContent = "erro ao salvar: " + (err.message || err);
        }
      };
    }catch(e){
      console.error(e);
      render(DEFAULT_DATA);
      $("adminStatus").textContent = "firebase falhou ao iniciar. usando dados locais.";
    }

    render(DEFAULT_DATA);
  </script>

  <!--
  regras simples para o realtime database funcionar do jeito que você pediu:

  {
    "rules": {
      "vakinha": {
        "public": {
          ".read": true,
          ".write": true
        }
      }
    }
  }

  isso deixa qualquer pessoa que descubra o caminho escrever no banco.
  a senha 040824 só esconde o painel na interface; não é segurança real.
  como não tem cpf/documento/lista de doadores, o risco principal é alguém zoar a barrinha.
  -->
</body>
</html>
